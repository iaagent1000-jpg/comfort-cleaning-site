# Canonical public site URL used in metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only destination for a Google Apps Script or Make-compatible webhook.
ASSESSMENT_WEBHOOK_URL=

# Optional server-only bearer token sent to the configured webhook.
ASSESSMENT_WEBHOOK_SECRET=

# Local development only. When true, validated requests are accepted locally.
# This is ignored in production and never creates a fake production success.
ASSESSMENT_DEV_MODE=false
